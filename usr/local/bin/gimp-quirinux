}

# PHOTOSHOP ICONOS Y ATAJOS

function _photoshop_de()
{
(
_borrar
echo "50"; sleep 1
echo "# Verarbeitung läuft"; sleep 1

_photoshop
echo "100"; sleep 1
echo "# Verarbeitung läuft"; sleep 1  

  
)|
zenity --progress --title="Konfiguration" --text="Bitte warten Sie, dies wird einige Zeit dauern" --percentage=0 --auto-close --auto-kill
if [ "$?" = -1 ] ; then
zenity --error --text="Konfiguration abgebrochen"
fi
}


# GIMP ICONOS Y ATAJOS

function _gimp_de()
{
(

_borrar
echo "50"; sleep 1
echo "# Verarbeitung läuft"; sleep 1

_gimp
echo "100"; sleep 1
echo "# Verarbeitung läuft"; sleep 1    

  
)|
zenity --progress --title="Konfiguration" --text="Bitte habe Geduld, dies wird einige Zeit dauern" --percentage=0 --auto-close --auto-kill
if [ "$?" = -1 ] ; then
zenity --error --text="Konfiguration abgebrochen"
fi
}


